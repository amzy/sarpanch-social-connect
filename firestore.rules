rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function validPostType(type) { return type in ['festival', 'development']; }
    function validClientPostCreate(postId) {
      return request.resource.data.keys().hasOnly([
        'postId', 'uid', 'type', 'contentLanguage', 'creationTimestamp', 'rawNotes',
        'beforeImageUrl', 'afterImageUrl', 'finalCompositedImage',
        'status', 'scheduledTime'
      ])
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.postId == postId
      && validPostType(request.resource.data.type)
      && request.resource.data.contentLanguage in ['English', 'Hindi', 'Marathi', 'Telugu', 'Tamil', 'Gujarati']
      && request.resource.data.status == 'pending_ai'
      && request.resource.data.creationTimestamp == request.time
      && request.resource.data.rawNotes is string
      && request.resource.data.beforeImageUrl is string
      && request.resource.data.afterImageUrl is string
      && request.resource.data.finalCompositedImage is string
      && (request.resource.data.scheduledTime == null || request.resource.data.scheduledTime is timestamp);
    }
    function validProfileFields(data) {
      return data.sarpanchName is string
        && data.panchayatName is string
        && data.district is string
        && data.state is string
        && data.primaryLanguage in ['English', 'Hindi', 'Marathi', 'Telugu', 'Tamil', 'Gujarati'];
    }
    function validUserKeys(data) {
      return data.keys().hasOnly([
        'uid', 'email', 'username', 'mobileNumber', 'profileComplete',
        'sarpanchName', 'panchayatName', 'sarpanchNameHindi', 'panchayatNameHindi', 'district', 'state',
        'primaryLanguage', 'imageUrl', 'sealUrl', 'createdAt',
        'plan', 'billingStatus'
      ]);
    }

    match /username_claims/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/username_claims/$(username))
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow create: if owns(uid)
        && validUserKeys(request.resource.data)
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.username is string
        && request.resource.data.mobileNumber is string
        && request.resource.data.plan == 'free'
        && request.resource.data.billingStatus == 'active'
        && (
          request.resource.data.profileComplete == false
          || (request.resource.data.profileComplete == true
            && validProfileFields(request.resource.data))
        );
      allow update: if owns(uid)
        && validUserKeys(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'sarpanchName', 'panchayatName', 'sarpanchNameHindi', 'panchayatNameHindi', 'district', 'state',
          'primaryLanguage', 'imageUrl', 'sealUrl', 'profileComplete'
        ])
        && request.resource.data.profileComplete == true
        && validProfileFields(request.resource.data);
      allow delete: if false;
      match /private/{document=**} { allow read, write: if false; }
    }

    match /posts_queue/{postId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && validClientPostCreate(postId);
      allow update: if isAdmin() || (signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && (
          (resource.data.status == 'pending_approval'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aiCaption', 'scheduledTime'])
            && request.resource.data.aiCaption is string)
          ||
          (resource.data.status == 'pending_approval'
            && request.resource.data.status == 'approved_to_publish'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'aiCaption'])
            && request.resource.data.aiCaption is string)
          ||
          (resource.data.status == 'pending_approval'
            && request.resource.data.status == 'rejected'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        ));
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}